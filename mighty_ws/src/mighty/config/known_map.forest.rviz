Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Core1
      Splitter Ratio: 0.8294117450714111
    Tree Height: 441
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 0.3499999940395355
          Cell Size: 1
          Class: rviz/Grid
          Color: 120; 120; 120
          Enabled: false
          Line Style:
            Line Width: 0.029999999329447746
            Value: Lines
          Name: Ground Grid
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 30
          Reference Frame: <Fixed Frame>
          Value: false
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 1
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 90; 145; 220
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Known Map (PCD)
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.10000000149011612
          Style: Flat Squares
          Topic: /NX01/known_map_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: false
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /NX01/polymap
          Name: Map PolyMap Surface
          Namespaces:
            surface: true
          Queue Size: 100
          Value: true
        - Class: rviz/MarkerArray
          Enabled: false
          Marker Topic: /NX01/polymap/boundary
          Name: Map Boundary Solids
          Namespaces:
            {}
          Queue Size: 100
          Value: false
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /NX01/drone_marker
          Name: UAV Pose
          Namespaces:
            known_map_uav: true
          Queue Size: 100
          Value: true
      Enabled: true
      Name: Core
    - Class: rviz/Group
      Displays:
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /NX01/shape_aware_astar/current_body
          Name: Current Collision Shape
          Namespaces:
            shape_aware_astar_current_body: true
          Queue Size: 100
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 190; 255
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.07999999821186066
          Name: Front-end Shape A* Path
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 255; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /NX01/shape_aware_astar/path
          Unreliable: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /NX01/shape_aware_astar/body_ghosts
          Name: Front-end Body Samples
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /NX01/traj_middle
          Name: Middle-stage Trajectory
          Namespaces:
            {}
          Queue Size: 100
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /NX01/traj_backend
          Name: Back-end Trajectory
          Namespaces:
            {}
          Queue Size: 100
          Value: true
      Enabled: true
      Name: Planning
  Enabled: true
  Global Options:
    Background Color: 35; 38; 45
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /NX01/term_goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 42.574188232421875
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0.10728071630001068
        Y: -0.026241619139909744
        Z: 0.7129592299461365
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.5497963428497314
      Target Frame: <Fixed Frame>
      Yaw: 6.273186206817627
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 900
  Hide Left Dock: true
  Hide Right Dock: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1368
  X: 72
  Y: 27
